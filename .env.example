# Copy to .env and adjust.
# The app expects the SQLAlchemy asyncpg dialect scheme:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foundit

# Command-line tools (dbmate) expect the plain scheme:
#   postgres://postgres:postgres@localhost:5433/foundit?sslmode=disable
# NOTE: the running volume was initialized with password "postgres";
# docker-compose.yml says "password" but auth as postgres:postgres works.

LOG_LEVEL=INFO
